[Unit]
Description=GitHub Actions Runner - PoC local image registry
After=default.target

[Service]
Type=exec
ExecStart=/usr/bin/docker run --rm --name github-actions-runner-poc-registry -p 127.0.0.1:15000:5000 --mount type=bind,src=/srv/github-actions-runner-poc/registry,dst=/var/lib/registry registry:2
ExecStartPost=/usr/bin/curl --fail --silent --retry 10 --retry-connrefused --retry-delay 1 http://127.0.0.1:15000/v2/
ExecStop=-/usr/bin/docker stop --time 20 github-actions-runner-poc-registry
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
