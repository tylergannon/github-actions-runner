[Unit]
Description=GitHub Actions Runner - Linux proof of concept
After=default.target
Requires=github-actions-runner-poc-registry.service
After=github-actions-runner-poc-registry.service

[Service]
Type=exec
WorkingDirectory=/srv/github-actions-runner-poc
EnvironmentFile=/srv/github-actions-runner-poc/secrets/service.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/github-actions-runner-poc/bin/github-actions-runner run --config /srv/github-actions-runner-poc/config/runner.toml
Restart=on-failure
RestartSec=10s
TimeoutStopSec=6100s
KillMode=control-group
SyslogIdentifier=github-actions-runner-poc

[Install]
WantedBy=default.target
